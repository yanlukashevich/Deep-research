# Keenable MCP (web search)
KEENABLE_URL=https://api.keenable.ai/mcp
KEENABLE_API_KEY=

# LiteLLM proxy (OpenAI-compatible)
LITELLM_BASE_URL=https://litellm.ispras.ru/
LITELLM_API_KEY=

# Models (chosen in Phase 0, see HANDOFF.md)
TARO_MAIN_MODEL=openai/gpt-oss-120b
TARO_FAST_MODEL=google/gemma4:31b

# Where runs are written. Leave empty for <repo>/runs. On a host that deploys the app read-only
# (Azure App Service), point it at a writable, persistent folder: TARO_RUNS_DIR=/home/runs
TARO_RUNS_DIR=
